# Planning baseline example configuration.
# Phase 00 owns the authoritative configuration list; each later phase
# documents the keys it introduces. Copy to .env and fill local values.
# Never commit real secrets.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL — the authoritative store; required for readiness checks
DATABASE_URL=postgresql+asyncpg://hitl:hitl@localhost:5432/hitl_ops

# Observability (optional in development)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Introduced by later phases — placeholder names only, do not fill yet:
# REDIS_URL=          # Phase 04+; accelerator only, never a source of truth
# OIDC_ISSUER=        # Phase 03
# OIDC_AUDIENCE=      # Phase 03
# LLM_PROVIDER_API_KEY=  # Phase 06; never reaches the execution path or infrastructure SDKs
