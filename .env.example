# Local / demo configuration for hitl_ops.
# Copy to .env and fill values. Never commit real secrets.
# Names match `hitl_ops.config.Settings` (and the worker's os.environ keys).

# Application
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL — authoritative store; required for readiness
DATABASE_URL=postgresql+asyncpg://hitl:hitl@localhost:5432/hitl_ops

# Identity (HS256 learning mode). Required for authenticated API calls.
# Without IDENTITY_SHARED_SECRET the API returns 403 on every protected route.
IDENTITY_ISSUER=https://test-issuer.local
IDENTITY_AUDIENCE=hitl-ops
IDENTITY_SHARED_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Request limits
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
ADDRESS_RATE_LIMIT_PER_MINUTE=600

# Worker (read by hitl_ops.worker_main, not Settings)
WORKER_TICK_INTERVAL_SECONDS=5
WORKER_MAX_BACKOFF_SECONDS=60

# Observability — parsed by Settings but no OTLP exporter ships in V1
# (see architecture-review §12). Leave unset unless you add an exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# V1 uses no Redis (architecture-review §13 / ADR-006).
# REDIS_URL=
